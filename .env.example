# Local development. Never commit real credentials.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hv_dev
# Tests only run against databases whose name ends in _test.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hv_test
# none | fake | psd2  (psd2 is prepared but not connected)
BANK_PROVIDER=none
# Encrypts two-factor secrets at rest: base64 of 32 random bytes.
# Generate with: openssl rand -base64 32
AUTH_SECRET_KEY=
# Set to false only for local development over plain HTTP.
COOKIE_SECURE=true
# none | fake | external  (external is prepared but not connected)
EMAIL_PROVIDER=none
DOCUMENT_EXTRACTION_PROVIDER=none
SUBSCRIPTION_BILLING_PROVIDER=none
